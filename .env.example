# Copiar a .env (`cp .env.example .env`). El compose tiene valores por defecto,
# así que `docker compose up` funciona incluso sin este archivo.

# --- PostgreSQL ---
POSTGRES_DB=smartbancs
POSTGRES_USER=smartbancs
POSTGRES_PASSWORD=smartbancs
POSTGRES_PORT=5432

# --- transaction-api ---
API_PORT=8000
# Debe coincidir con las credenciales de arriba; el host es el nombre del servicio en el compose.
DATABASE_URL=postgresql+asyncpg://smartbancs:smartbancs@postgres:5432/smartbancs

# Pool de conexiones (cuello de botella a vigilar bajo carga)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=5

# --- Observabilidad ---
LOG_LEVEL=INFO
# Vacío = no exportar trazas. Ejemplo con un colector: http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_PORT=9090

# --- IA y outbox (Fase 5) ---
AI_SERVICE_URL=http://ai-service:8001
AI_PORT=8001
# Rango en ms ("300-800") o valor fijo ("500"): latencia deliberada del mock de IA
AI_SIMULATED_LATENCY_MS=300-800
# 0.0 - 1.0: probabilidad de que la IA responda 503 (demos de resiliencia)
AI_FAILURE_RATE=0
WORKER_DB_POOL_SIZE=5
# false (recomendado) = solo el worker (proceso aparte) notifica a la IA; la API no depende de ella.
# true = ademas la API notifica en BackgroundTasks tras el commit (paso 10 literal del brief).
AI_NOTIFY_IN_PROCESS=false
