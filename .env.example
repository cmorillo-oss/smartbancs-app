# Copiar a .env (`cp .env.example .env`). El compose tiene valores por defecto,
# así que `docker compose up` funciona incluso sin este archivo.

# --- PostgreSQL ---
POSTGRES_DB=smartbancs
POSTGRES_USER=smartbancs
POSTGRES_PASSWORD=smartbancs
POSTGRES_PORT=5432

# --- transaction-api ---
API_PORT=8000
# Debe coincidir con las credenciales de arriba; el host es el nombre del servicio en el compose.
DATABASE_URL=postgresql+asyncpg://smartbancs:smartbancs@postgres:5432/smartbancs

# Pool de conexiones (cuello de botella a vigilar bajo carga)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=5
